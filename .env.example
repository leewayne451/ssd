FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///chateau.db
UPLOAD_DIR=uploads
LOG_DIR=logs

# Bootstrap administrator (optional). Recommended: set ONLY ADMIN_EMAIL —
# `flask seed-admin` (run automatically by the Docker entrypoint) then
# generates a strong SINGLE-USE password, prints it once to the container
# log, and forces a password change on first login, so no secret ever sits
# in this file. Idempotent: an existing account is never touched.
# ADMIN_PASSWORD may still be set explicitly for local development (must
# satisfy the zxcvbn policy, FSR-02; not force-rotated). Either way the
# admin must enrol TOTP 2FA at /admin after rotating (FSR-01).
#ADMIN_EMAIL=admin@example.com
#ADMIN_PASSWORD=only-for-local-dev-pick-a-strong-passphrase
