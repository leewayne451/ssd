FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///chateau.db
UPLOAD_DIR=uploads
LOG_DIR=logs

# Bootstrap administrator (optional). If BOTH are set, `flask seed-admin`
# (run automatically by the Docker entrypoint, or manually) creates this
# admin account once — idempotent, never resets an existing password.
# The password must satisfy the zxcvbn policy (FSR-02), and the admin must
# still enrol TOTP 2FA on first /admin visit (FSR-01).
#ADMIN_EMAIL=admin@example.com
#ADMIN_PASSWORD=pick-a-strong-passphrase
